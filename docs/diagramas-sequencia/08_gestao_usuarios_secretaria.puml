@startuml
!include _tema.puml
title UC024-UC026 - Gestão de usuários da secretaria

actor "Admin UniEvent" as Admin
actor "Candidato a Secretaria" as Candidato
participant "Web" as Web
participant "UsuarioSecretariaController" as Api
participant "UsuarioSecretariaService" as Service
database "SQL Server" as DB

opt Solicitação pública de cadastro
  Candidato -> Web : Informa dados e instituição
  Web -> Api : POST /api/UsuarioSecretaria/solicitar-cadastro
  Api -> Api : Define role Secretaria e status Pendente
  Api -> Service : CriarUsuarioSecretaria(request)
  Service -> DB : Valida e salva solicitação
  Api --> Web : 200 pendente ou 400 erros
end

Admin -> Web : Abre Usuários da secretaria
Web -> Api : GET /api/UsuarioSecretaria
Api -> Api : Valida Admin global
Api -> Service : ListarUsuarioSecretaria()
Service -> DB : Consulta usuários e instituições
DB --> Service : Usuários
Service --> Api : Lista
Api --> Web : 200 usuários

alt Cadastrar diretamente
  Admin -> Web : Informa dados e instituição
  Web -> Api : POST /api/UsuarioSecretaria
  Api -> Api : Força status Ativo e role Secretaria
  Api -> Service : CriarUsuarioSecretaria(request)
  Service -> DB : Salva usuário
else Aprovar solicitação
  Admin -> Web : Aprova usuário pendente
  Web -> Api : PATCH /api/UsuarioSecretaria/{id}/aprovar
  Api -> Service : AlterarStatus(..., Ativo)
  Service -> DB : Atualiza status
else Bloquear ou recusar
  Admin -> Web : Escolhe Bloquear ou Recusar
  Web -> Api : PATCH /api/UsuarioSecretaria/{id}/bloquear|recusar
  Api -> Service : AlterarStatus(...)
  Service -> DB : Atualiza status
end

alt Operação concluída
  Service --> Api : Usuário atualizado
  Api --> Web : 200
  Web --> Admin : Atualiza listagem
else Operação inválida
  Api --> Web : 400, 403 ou 404
  Web --> Admin : Exibe o motivo
end
@enduml

