@startuml
!include _tema.puml
title UC024 - Gerenciar usuários da secretaria
|Admin UniEvent|
start
:Solicita a relação de usuários da secretaria;
|Gestão de acessos institucionais|
if (Administrador está autorizado?) then (Sim)
  if (Há usuários cadastrados?) then (Sim)
    :Apresenta usuários, instituições e situações;
  else (Não - exceção)
    :Apresenta relação vazia e opção de cadastro;
  endif
  |Admin UniEvent|
  :Escolhe cadastrar ou avaliar a situação de um usuário;
  |Gestão de acessos institucionais|
  :Encaminha para o processo escolhido;
else (Não - exceção)
  :Nega o acesso à gestão de usuários;
endif
stop
@enduml
